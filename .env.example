# ==============================================================================
# PUBGFRAMES — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env.local for local development, or configure these
# exact keys in Vercel Dashboard -> Settings -> Environment Variables.
# ==============================================================================

# 1. Single Superuser Admin Authentication (Server-Only — NEVER use NEXT_PUBLIC_)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-random-32-byte-secret

# 2. Supabase Cloud Database Configuration
# Copy from Supabase Dashboard -> Project Settings -> API (or API Keys):
# Note: After adding env vars in Vercel (Production & Preview), Redeploy without Build Cache.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# 3. Google Search Console, Google Analytics 4 & AdSense
# Set in Vercel Dashboard -> Settings -> Environment Variables:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# 4. Production Site URL (e.g. https://pubgframes.com or https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=https://pubgframes.com
